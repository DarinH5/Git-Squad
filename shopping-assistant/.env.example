# Backend
SECRET_KEY=replace-with-a-long-random-secret
DB_PATH=
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional AI provider. Core shopping search works without this key.
GEMINI_API_KEY=
